# =============================================================================
#  Environment variables
#
#  Copy to .env for local work:      cp .env.example .env
#  .env is gitignored. .env.example is committed and must never hold a real
#  secret — it is the documentation, not the configuration.
#
#  WHERE THESE ARE ACTUALLY READ
#
#    Netlify   Site configuration -> Environment variables. This is the one
#              that matters: the deployed site reads nothing from a .env file.
#
#    Locally   `netlify dev` loads .env automatically, which is the only way
#              to exercise netlify/functions/ on your machine.
#              `npm run dev` (python -m http.server) does NOT read it — it
#              serves static files, so the app uses the committed config.js
#              and the Netlify functions are simply absent.
#
#  NO "VITE_" PREFIX ON ANYTHING
#
#  There is no Vite in this project, and that prefix is not decoration: it
#  means "safe to inline into the client bundle". Using it on some variables
#  invites somebody to make the set look uniform by adding it to the
#  service_role key, which is the one name it must never be attached to.
#  The line that matters is PUBLIC vs SECRET, and it is drawn below.
#
#  (The old VITE_SUPABASE_* names are still read as a fallback so a deploy
#  keeps working mid-rename. The build log nags until you delete them.)
# =============================================================================


# -----------------------------------------------------------------------------
#  PUBLIC — written into config.js, which every visitor downloads
#
#  All optional. Unset, the committed config.js defaults are used. Set them to
#  point a deploy at a different Supabase project without editing any code.
#
#  The publishable key is designed to be public: it grants only what Row Level
#  Security allows, and every table has RLS enabled. Putting these in the
#  environment is about not editing code, not about secrecy.
# -----------------------------------------------------------------------------

# Supabase -> Project Settings -> Data API -> Project URL.
# Also read by netlify/functions/ for the admin panel's auth actions, which is
# why it must be the DIRECT project URL — the proxy goes in the next variable.
# The build refuses any value that is not https://<ref>.supabase.co.
SUPABASE_URL=https://your-project.supabase.co

# Cloudflare Worker in front of Supabase, for ISPs that will not route to
# *.supabase.co. Browser only. Leave blank to talk to Supabase directly.
SUPABASE_PROXY_URL=

# Supabase -> Project Settings -> API Keys -> anon / publishable.
# Also used by netlify/functions/ as the apikey header; identity always comes
# from the caller's own token, so it is optional there.
SUPABASE_ANON_KEY=your-publishable-key


# -----------------------------------------------------------------------------
#  SECRET — server side only, read by netlify/functions/
#
#  Never written into config.js, never delivered to a browser. If one of these
#  turns up in a deployed file, Netlify's secret scanner fails the build —
#  which is why it is left on in netlify.toml.
# -----------------------------------------------------------------------------

# Supabase -> Project Settings -> API Keys -> service_role.
#
# Bypasses every RLS policy. Netlify's environment and nowhere else: never in
# config.js, never with a VITE_ prefix, never committed.
#
# Without it the admin panel still reads and edits profiles, but block,
# create, delete, password links and "sign in as" all report that they are
# not configured.
SUPABASE_SERVICE_ROLE_KEY=

# The receipt scanner's cloud readers, tried in this order. Set as many as you
# like: the first that answers wins, and one being out of quota just moves to
# the next. With none set, scanning falls back to on-device OCR, which is
# noticeably worse — it reads the ₹ sign as a digit and loses decimal points.
#   Gemini  https://aistudio.google.com/apikey
#   OpenAI  https://platform.openai.com/api-keys
#   Claude  https://console.anthropic.com/settings/keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Pin one model per provider instead of walking the built-in list.
# Set these only when a newer model lands before that list is updated.
GEMINI_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=
